# Copier en .env et renseigner les vraies valeurs (ne jamais committer .env)

# Django
DJANGO_SECRET_KEY=change-me-generate-with-get_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Base de donnees - MySQL par defaut (demande)
DB_ENGINE=django.db.backends.mysql
DB_NAME=gestion_frais_meriba
DB_USER=root
DB_PASSWORD=0
DB_HOST=127.0.0.1
DB_PORT=3306
# Pour repasser en SQLite (dev sans MySQL) :
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# Email (console en dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

